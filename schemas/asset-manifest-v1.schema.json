{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "default": false,
          "title": "Approved",
          "type": "boolean"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "approved_artifact_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Approved Artifact Hashes",
          "type": "object"
        },
        "custody_assertion_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custody Assertion Sha256"
        },
        "custody_source_inputs": {
          "items": {
            "$ref": "#/$defs/CustodySourceInput"
          },
          "title": "Custody Source Inputs",
          "type": "array"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "Approval",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "format": {
          "title": "Format",
          "type": "string"
        },
        "path": {
          "description": "Forward-slash workspace-relative path without traversal",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "source_task_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Task Key"
        },
        "processor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Processor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "artifact_id",
        "role",
        "stage",
        "format",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "AssetIdentity": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "lane": {
          "minLength": 1,
          "title": "Lane",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "display_name",
        "lane",
        "created_at",
        "updated_at"
      ],
      "title": "AssetIdentity",
      "type": "object"
    },
    "CustodyAssertion": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "vandrel_foundry_candidate_custody/1.0",
            "vandrel_foundry_candidate_custody/1.1",
            "vandrel_foundry_candidate_custody/1.2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_status": {
          "enum": [
            "absent",
            "historical_unassessed",
            "evaluated"
          ],
          "title": "Assessment Status",
          "type": "string"
        },
        "source_contributions": {
          "items": {
            "$ref": "#/$defs/CustodySourceContribution"
          },
          "title": "Source Contributions",
          "type": "array"
        },
        "policy_schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Schema Version"
        },
        "policy_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Sha256"
        },
        "register_schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register Schema Version"
        },
        "register_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register Sha256"
        },
        "register_root_fingerprints": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "maxProperties": 3,
              "minProperties": 3,
              "propertyNames": {
                "enum": [
                  "outside_assets",
                  "foundry_workspace",
                  "asset_library"
                ]
              },
              "type": "object"
            },
            {
              "additionalProperties": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "maxProperties": 1,
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "outside_assets",
                  "foundry_workspace",
                  "asset_library"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register Root Fingerprints"
        },
        "evidence_fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Fingerprint Sha256"
        },
        "evaluated_manifest_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Manifest Revision"
        },
        "effective_rights_status": {
          "anyOf": [
            {
              "enum": [
                "documented",
                "missing",
                "disputed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Rights Status"
        },
        "semantic_assertion_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Assertion Sha256"
        }
      },
      "required": [
        "schema_version",
        "assessment_status"
      ],
      "title": "CustodyAssertion",
      "type": "object"
    },
    "CustodyLicenseEvidence": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "original_evidence_path": {
          "anyOf": [
            {
              "description": "Forward-slash workspace-relative path without traversal",
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/PortableCustodyPath"
            }
          ],
          "title": "Original Evidence Path"
        },
        "evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "scope_root": {
          "anyOf": [
            {
              "description": "Forward-slash workspace-relative path without traversal",
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/PortableCustodyPath"
            }
          ],
          "title": "Scope Root"
        },
        "rights_semantics": {
          "const": "documented",
          "title": "Rights Semantics",
          "type": "string"
        },
        "candidate_evidence_artifact_id": {
          "minLength": 1,
          "title": "Candidate Evidence Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "original_evidence_path",
        "evidence_sha256",
        "size_bytes",
        "scope_root",
        "rights_semantics",
        "candidate_evidence_artifact_id"
      ],
      "title": "CustodyLicenseEvidence",
      "type": "object"
    },
    "CustodySourceContribution": {
      "additionalProperties": false,
      "properties": {
        "contribution_id": {
          "minLength": 1,
          "title": "Contribution Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "package_id": {
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "package_root": {
          "anyOf": [
            {
              "description": "Forward-slash workspace-relative path without traversal",
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/PortableCustodyPath"
            }
          ],
          "title": "Package Root"
        },
        "source_inputs": {
          "items": {
            "$ref": "#/$defs/CustodySourceInput"
          },
          "title": "Source Inputs",
          "type": "array"
        },
        "rights_status": {
          "enum": [
            "documented",
            "missing",
            "disputed"
          ],
          "title": "Rights Status",
          "type": "string"
        },
        "license_evidence": {
          "items": {
            "$ref": "#/$defs/CustodyLicenseEvidence"
          },
          "title": "License Evidence",
          "type": "array"
        }
      },
      "required": [
        "contribution_id",
        "source_id",
        "package_id",
        "package_root",
        "rights_status"
      ],
      "title": "CustodySourceContribution",
      "type": "object"
    },
    "CustodySourceInput": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "role",
        "sha256",
        "size_bytes"
      ],
      "title": "CustodySourceInput",
      "type": "object"
    },
    "Generation": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "selected_task_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Task Key"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/ProviderTask"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "provider"
      ],
      "title": "Generation",
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "text",
          "enum": [
            "text",
            "image",
            "external"
          ],
          "title": "Kind",
          "type": "string"
        },
        "prompt_file": {
          "default": "input/prompt.txt",
          "description": "Forward-slash workspace-relative path without traversal",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
          "title": "Prompt File",
          "type": "string"
        },
        "reference_images": {
          "items": {
            "description": "Forward-slash workspace-relative path without traversal",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "title": "Reference Images",
          "type": "array"
        }
      },
      "title": "Input",
      "type": "object"
    },
    "PortableCustodyPath": {
      "additionalProperties": false,
      "properties": {
        "logical_root": {
          "enum": [
            "outside_assets",
            "foundry_workspace",
            "asset_library"
          ],
          "title": "Logical Root",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)[^/]+(?:/[^/]+)*$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "logical_root",
        "path"
      ],
      "title": "PortableCustodyPath",
      "type": "object"
    },
    "Processor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Processor",
      "type": "object"
    },
    "ProviderTask": {
      "additionalProperties": false,
      "properties": {
        "task_key": {
          "title": "Task Key",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "provider_task_id": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Task Id"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ProviderTaskStatus"
        },
        "progress": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "consumed_credits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumed Credits"
        },
        "request_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Fingerprint"
        },
        "request_path": {
          "anyOf": [
            {
              "description": "Forward-slash workspace-relative path without traversal",
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Path"
        },
        "response_path": {
          "anyOf": [
            {
              "description": "Forward-slash workspace-relative path without traversal",
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Path"
        },
        "response_snapshots": {
          "items": {
            "description": "Forward-slash workspace-relative path without traversal",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "title": "Response Snapshots",
          "type": "array"
        },
        "submitted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submitted At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "task_key",
        "provider",
        "operation",
        "attempt",
        "status"
      ],
      "title": "ProviderTask",
      "type": "object"
    },
    "ProviderTaskStatus": {
      "description": "Foundry-local and provider-reported task states.",
      "enum": [
        "READY",
        "SUBMITTING",
        "SUBMISSION_FAILED",
        "AMBIGUOUS",
        "PENDING",
        "IN_PROGRESS",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ],
      "title": "ProviderTaskStatus",
      "type": "string"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "targets": {
          "additionalProperties": true,
          "title": "Targets",
          "type": "object"
        },
        "observed": {
          "additionalProperties": true,
          "title": "Observed",
          "type": "object"
        }
      },
      "title": "Quality",
      "type": "object"
    },
    "Release": {
      "additionalProperties": false,
      "properties": {
        "released": {
          "default": false,
          "title": "Released",
          "type": "boolean"
        },
        "release_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Revision"
        },
        "released_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released At"
        }
      },
      "title": "Release",
      "type": "object"
    },
    "ScaleCalibration": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "not_calibrated",
          "enum": [
            "not_calibrated",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        },
        "processed_model_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processed Model Sha256"
        },
        "preview_report_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Report Sha256"
        },
        "source_bounds_min": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Bounds Min"
        },
        "source_bounds_max": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Bounds Max"
        },
        "source_dimensions": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Dimensions"
        },
        "target_height_meters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Height Meters"
        },
        "baseline_uniform_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Uniform Scale"
        },
        "variation_min_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variation Min Multiplier"
        },
        "variation_max_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variation Max Multiplier"
        },
        "reference_standard": {
          "anyOf": [
            {
              "const": "meter_grid_and_human_1_8m",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Standard"
        },
        "reviewer": {
          "anyOf": [
            {
