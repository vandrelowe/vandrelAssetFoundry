          "default": null,
          "title": "Visible Mesh Count"
        },
        "visible_skinned_mesh_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible Skinned Mesh Count"
        },
        "visible_unskinned_mesh_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible Unskinned Mesh Count"
        },
        "visible_skinned_triangle_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible Skinned Triangle Count"
        },
        "inspected_processed_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspected Processed Artifact Id"
        },
        "inspected_processed_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspected Processed Sha256"
        },
        "animation_source": {
          "anyOf": [
            {
              "const": "meshy_same_rigging_task",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Animation Source"
        },
        "recommended_fbx_embedded_texture_handling": {
          "anyOf": [
            {
              "const": "embed_basis_universal",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Fbx Embedded Texture Handling"
