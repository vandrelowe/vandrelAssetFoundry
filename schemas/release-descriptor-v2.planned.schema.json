        "collision_recommendation": {
          "enum": [
            "manual",
            "manual_review",
            "manual_simple_convex",
            "none"
          ],
          "title": "Collision Recommendation",
          "type": "string"
        }
      },
      "required": [
        "collision_recommendation"
      ],
      "title": "ReleaseTechnicalV2",
      "type": "object"
    },
    "RetargetHumanoidCompatibilityV2": {
      "additionalProperties": false,
      "properties": {
        "evidence_route": {
          "const": "retarget_mapping",
          "title": "Evidence Route",
          "type": "string"
        },
        "candidate_only": {
          "const": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "vandrel_runtime_accepted": {
          "const": false,
          "title": "Vandrel Runtime Accepted",
          "type": "boolean"
        },
        "mapping_profile": {
          "minLength": 1,
          "title": "Mapping Profile",
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/PackagedHumanoidReportV2"
        },
        "animation_donor_asset_id": {
          "pattern": "^[a-z0-9][a-z0-9_]{2,63}$",
          "title": "Animation Donor Asset Id",
          "type": "string"
        },
        "direct_skeleton_match": {
          "title": "Direct Skeleton Match",
          "type": "boolean"
        },
        "direct_rest_transform_match": {
          "title": "Direct Rest Transform Match",
          "type": "boolean"
        },
        "humanoid_retarget_candidate": {
          "const": true,
          "title": "Humanoid Retarget Candidate",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_route",
        "candidate_only",
        "vandrel_runtime_accepted",
        "mapping_profile",
        "report",
        "animation_donor_asset_id",
        "direct_skeleton_match",
        "direct_rest_transform_match",
        "humanoid_retarget_candidate"
      ],
      "title": "RetargetHumanoidCompatibilityV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "asset_id": {
      "pattern": "^[a-z0-9][a-z0-9_]{2,63}$",
      "title": "Asset Id",
      "type": "string"
    },
    "release_revision": {
      "maximum": 999,
      "minimum": 1,
      "title": "Release Revision",
      "type": "integer"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "lane": {
      "minLength": 1,
      "title": "Lane",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ReleaseFileV2"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "godot": {
      "$ref": "#/$defs/ReleaseGodotV2"
    },
    "technical": {
      "$ref": "#/$defs/ReleaseTechnicalV2"
    },
    "custody": {
      "$ref": "#/$defs/ReleaseCustodyV2"
    },
    "humanoid_compatibility": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetargetHumanoidCompatibilityV2"
        },
        {
          "$ref": "#/$defs/NativeHumanoidCompatibilityV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Humanoid Compatibility"
    },
    "provenance": {
      "$ref": "#/$defs/ReleaseProvenanceV2"
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "release_revision",
    "display_name",
    "lane",
    "files",
    "godot",
    "technical",
    "custody",
    "provenance"
  ],
  "title": "ReleaseDescriptorV2",
  "type": "object"
}
